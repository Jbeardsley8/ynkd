{
    "name": "ynkd",
    "version": "0.1.0",
    "description": "Clipboard manager built using electron",
    "author": "jbeardsley",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc && npm run copy-assets",
        "copy-assets": "copyfiles -u 1 \"src/**/*.{html,css}\" dist",
        "start": "npm run build && electron .",
        "dist": "npm run build && electron-builder"
    },
    "build": {
        "appId": "com.jbeardsley.ynkd",
        "productName": "ynkd",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.productivity"
        }
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "copyfiles": "^2.4.1",
        "electron": "^42.0.1",
        "electron-builder": "^26.8.1",
        "typescript": "^5.4.0"
    }
}