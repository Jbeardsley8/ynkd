{
    "name": "ynkd",
    "version": "0.1.0",
    "description": "Clipboard manager built using electron",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc && npm run copy-assets",
        "copy-assets": "copyfiles -u 1 \"src/**/*.{html,css}\" dist",
        "start": "npm run build && electron ."
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "copyfiles": "^2.4.1",
        "electron": "^42.0.1",
        "typescript": "^5.4.0"
    }
}